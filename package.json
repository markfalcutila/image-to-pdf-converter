{
  "name": "img-pdf-converter",
  "version": "1.0.0",
  "description": "Convert images and merge PDFs into a single PDF file.",
  "main": "main.js",
  "scripts": {
    "start": "nodemon index.ts",
    "start:electron": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@ilovepdf/ilovepdf-nodejs": "^0.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "heic-convert": "^2.1.0",
    "image-to-pdf": "^3.0.0",
    "multer": "^2.0.2",
    "nodemon": "^3.1.11",
    "pdf-lib": "^1.17.1",
    "pdf-merger-js": "^4.3.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.missy.imgpdf",
    "productName": "MISSY PDF Converter",
    "asar": true,
    "files": [
      "main.js",
      "index.js",
      "package.json",
      "public/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      "uploads",
      "output"
    ],
    "win": {
      "target": "nsis"
    }
  },
  
  "devDependencies": {
    "electron": "^40.0.0"
  },

  "author": "Mark Joseph Falcutila"
}
